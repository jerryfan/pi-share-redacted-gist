{
  "name": "pi-share-redacted-gist",
  "version": "0.7.0",
  "description": "Pi package: publish a redacted pi session to GitHub gists and first-class Hugging Face datasets",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "gist",
    "github",
    "huggingface",
    "redaction",
    "openagentsessions"
  ],
  "files": [
    "extensions/*.ts",
    "!extensions/*.test.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "bun test",
    "check": "bun test && bun -e \"import('./extensions/share-redacted-gist.ts').then(() => console.log('ok'))\"",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "pi": {
    "extensions": [
      "./extensions/share-redacted-gist.ts"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lukaskawerau/pi-share-redacted-gist.git"
  },
  "homepage": "https://github.com/lukaskawerau/pi-share-redacted-gist#readme",
  "bugs": {
    "url": "https://github.com/lukaskawerau/pi-share-redacted-gist/issues"
  },
  "dependencies": {
    "@huggingface/hub": "^2.11.0"
  }
}
